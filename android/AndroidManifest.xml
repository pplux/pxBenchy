<?xml version="1.0" encoding="utf-8"?>
<!-- NativeActivity only, no Java code. build_apk.sh adds android:debuggable to debug builds (bundled validation layer)
     and versionCode / versionName from the CMake project version. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pplux.pxbenchy">

  <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />
  <!-- Vulkan 1.1 minimum (vk11 backend). The vk13 backend (dynamic rendering, sync2) is picked at runtime when supported -->
  <uses-feature android:name="android.hardware.vulkan.version" android:version="0x401000" android:required="true" />
  <!-- update check (GitHub releases) and the Tracy profiler's socket -->
  <uses-permission android:name="android.permission.INTERNET" />

  <application
      android:label="pxBenchy"
      android:hasCode="false"
      android:extractNativeLibs="true">
    <activity
        android:name="android.app.NativeActivity"
        android:exported="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:screenOrientation="landscape"
        android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|smallestScreenSize|density|uiMode">
      <meta-data android:name="android.app.lib_name" android:value="pxbenchy" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
